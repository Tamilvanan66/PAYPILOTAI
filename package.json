{
  "name": "paypilot-ai",
  "private": true,
  "version": "1.0.0",
  "description": "PayPilot AI - AI-Powered Smart Commerce & Payment Assistant",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace server run build && npm --workspace client run build",
    "test": "npm --workspace server run test && npm --workspace client run test",
    "test:server": "npm --workspace server run test",
    "test:client": "npm --workspace client run test",
    "seed": "npm --workspace server run seed",
    "start": "npm --workspace server run start",
    "typecheck": "npm --workspace server run typecheck && npm --workspace client run typecheck"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "concurrently": "^9.1.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
